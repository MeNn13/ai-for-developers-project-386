{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**"],
  "workspaces": {
    "frontend": {
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": ["src/api/generated/**"]
    },
    "contract": {
      "ignoreDependencies": [
        "@typespec/http",
        "@typespec/json-schema",
        "@typespec/openapi",
        "@typespec/openapi3",
        "@typespec/rest"
      ]
    }
  }
}
