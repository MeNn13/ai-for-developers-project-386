{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings --ignore-pattern src/api/generated --ignore-pattern dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/core": "9.7.4",
    "@mantine/dates": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "dayjs": "1.11.23",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
