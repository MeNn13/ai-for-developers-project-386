<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Probe.cs" />
    <Compile Include="artifacts/generated/@typespec/http-server-csharp/generated/models/*.cs" />
    <Compile Include="artifacts/generated/@typespec/http-server-csharp/generated/lib/*.cs"
             Exclude="artifacts/generated/@typespec/http-server-csharp/generated/lib/HttpServiceException.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
